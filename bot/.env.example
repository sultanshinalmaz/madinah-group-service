# Запуск на своём компьютере: скопируйте этот файл в bot/.env.
# Полный список переменных (в том числе для Vercel) — в .env.example в корне проекта.

# Токен бота от @BotFather (команда /newbot). Никому не показывайте.
BOT_TOKEN=

# Числовой Telegram ID администратора (@RakhimovAbdullah) — именно номер, не @username.
# Узнать: написать боту /id или @userinfobot.
ADMIN_TELEGRAM_ID=593048264

# Адрес приложения со слэшем в конце (для кнопок бота). Локально можно не трогать.
APP_URL=https://madinah-group.vercel.app/

# Порт локального сервера
PORT=8443

# Где хранить данные: JSON-файлы. Если задать DATABASE_URL, данные пойдут в Postgres.
# DATA_DIR=bot/data
# DATABASE_URL=

# Предел размера файла при загрузке из панели, МБ (на своём сервере можно много)
MAX_UPLOAD_MB=300

# Почта для бесплатного переводчика MyMemory: лимит 50 000 знаков в день вместо 5 000
# TRANSLATE_EMAIL=you@example.com

# 0 — не опрашивать Telegram (проверка с тестовым токеном)
# BOT_POLLING=1
