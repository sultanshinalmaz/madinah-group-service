# ============================================================================
#  Madinah Group — переменные окружения
#
#  На Vercel:  Settings → Environment Variables (отметьте Production, Preview, Development)
#  У себя:     скопируйте этот файл в bot/.env и запускайте node bot/server.js
#
#  В репозиторий .env не попадает (см. .gitignore) — секреты живут только здесь и в Vercel.
# ============================================================================

# ------------------------------- обязательные -------------------------------

# Токен бота от @BotFather (команда /newbot). Никому не показывайте.
BOT_TOKEN=

# Числовой Telegram ID администратора (@RakhimovAbdullah). Именно номер, не @username:
# username можно сменить или передать, id — нет. Узнать: написать боту /id или @userinfobot.
# Несколько администраторов — через запятую.
ADMIN_TELEGRAM_ID=593048264

# Адрес приложения со слэшем в конце. На Vercel это домен проекта.
# Отсюда же берётся адрес вебхука и адрес админки (APP_URL + admin).
APP_URL=https://madinah-group.vercel.app/

# --------------------- хранилище (нужно только на Vercel) --------------------

# Postgres: квартиры, услуги, тексты админки, заявки, отчёт.
# Neon (Vercel Marketplace), Supabase или любой другой Postgres.
# При подключении базы через Vercel переменная появляется сама — вписывать вручную не нужно.
DATABASE_URL=

# Vercel Blob: загруженные фото и видео.
# Появляется сама при подключении хранилища Blob к проекту.
BLOB_READ_WRITE_TOKEN=

# Необязательно: адрес хранилища Blob вида https://xxxxxxxx.public.blob.vercel-storage.com
# Нужен, только если в данных остались старые ссылки вида /media/…
BLOB_BASE_URL=

# ------------------------------------ бот -----------------------------------

# Пароль вебхука: Telegram присылает его в заголовке, чужие запросы отсекаются.
# Придумайте длинную строку из латинских букв и цифр.
WEBHOOK_SECRET=

# ------------------------------- необязательные ------------------------------

# Почта для бесплатного переводчика MyMemory: с ней лимит 50 000 знаков в день вместо 5 000
# TRANSLATE_EMAIL=you@example.com

# Предел размера файла при загрузке из панели, МБ.
# На Vercel больше 4 поставить нельзя: функции не принимают тело запроса больше 4,5 МБ.
# MAX_UPLOAD_MB=4

# ---------------------- только для запуска у себя ---------------------------

# Порт локального сервера
# PORT=8443

# Где хранить данные, если нет DATABASE_URL (JSON-файлы)
# DATA_DIR=bot/data

# Свой сервер с вебхуком вместо опроса Telegram
# WEBHOOK_URL=https://example.com/webhook

# 0 — не опрашивать Telegram (проверка с тестовым токеном)
# BOT_POLLING=1

# Прежнее имя ADMIN_TELEGRAM_ID — тоже читается
# ADMIN_IDS=
